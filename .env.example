# Copy to .env (git-ignored). Bun loads .env automatically.

# "today" for every derivation; unset = the real clock. Useful for demos of the sample data.
# VALUEFLOW_NOW=2026-09-10T09:00:00Z

# Where development facts come from: sample | github | none
SYNC_SOURCE=sample
# GITHUB_TOKEN=ghp_...
# Re-sync every project on a timer (minutes); 0 or unset = only on demand and at boot
# SYNC_INTERVAL_MIN=30

# OpenAI-compatible chat endpoint for agent runs (vLLM, OpenAI, LiteLLM, Ollama…). Unset = agents disabled.
LLM_BASE_URL=https://llm.almckay.io/v1
# LLM_API_KEY=
# LLM_MODEL=            # default: first model the endpoint lists
# LLM_THINKING=on       # let reasoning models think (slower, more tokens)
# EVAL_JUDGE=off        # skip the background LLM judge on every run (rules scores still recorded)
# EVAL_JUDGE_MODEL=     # grade runs with a different model than the agents use
# LLM_MODELS=           # comma-separated candidates for the scout, e.g. gpt-5-mini@https://api.openai.com/v1
# BRIEF_WEBHOOK_URL=    # POST the weekly brief as JSON (Slack/Teams/Zapier or your own endpoint)
# GLANCE_CURATE=off     # keep Glance in the composer's default order (no background re-curation)
# LLM_PRICES=           # USD per million tokens by model, e.g. Qwen3.6-35B-A3B-NVFP4=0.20/0.60,gpt-5-mini=0.25/2.00 (spend in dollars, budgets in dollars)
# AGENT_SCHEDULE=off    # disable nightly agent runs

# PORT=3000
# HOST=127.0.0.1          # default: loopback only
# Shared hosting requires a trusted authenticating proxy that injects this bearer token.
# Build the app first. Use a random secret of at least 32 characters; never expose it in browser code.
# VALUEFLOW_ACCESS_TOKEN=
# VALUEFLOW_ORIGINS=https://valueflow.example.com
# Alternate model endpoints must be listed in LLM_MODELS and use their own credentials.
# LLM_PROVIDER_SECONDARY_BASE_URL=https://secondary.example.com/v1
# LLM_PROVIDER_SECONDARY_API_KEY=
# VALUEFLOW_DB=data/valueflow.sqlite
