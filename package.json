{
  "name": "exponential",
  "version": "0.1.0",
  "private": true,
  "description": "Exponential — evidence-led AI project delivery for shared workspaces.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "doctor": "bash scripts/doctor.sh",
    "dev": "bun run --cwd packages/server dev",
    "start": "bun run --cwd packages/server start",
    "demo:reset": "bun run --cwd packages/server seed",
    "sync": "bun run --cwd packages/server sync",
    "build": "bun run --cwd packages/web build",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --config oxlint.json packages",
    "docs:check": "bun scripts/check-docs.ts",
    "skills:check": "bun scripts/check-agent-skills.ts",
    "check": "bun run typecheck && bun run lint && bun test && bun run docs:check && bun run skills:check",
    "test:e2e": "bun run build && bun packages/server/e2e/release.ts",
    "release:check": "bun run check && bun run test:e2e && git diff --check",
    "container:build": "bash scripts/container.sh build",
    "container:test": "bash scripts/container.sh test"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.6.0"
  }
}
