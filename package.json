{
  "name": "exponential",
  "version": "0.1.0",
  "private": true,
  "description": "ValueFlow — AI-project delivery platform: value tied to performance-gated milestones, release go-live criteria, and governance.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/server dev",
    "start": "bun run --cwd packages/server start",
    "seed": "bun run --cwd packages/server seed",
    "sync": "bun run --cwd packages/server sync",
    "build": "bun run --cwd packages/web build",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "lint": "bunx oxlint --config oxlint.json packages",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.6.0"
  }
}
